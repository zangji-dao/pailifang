{
  "name": "projects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm build:web && pnpm build:backend",
    "build:web": "next build",
    "build:backend": "pnpm --dir backend build",
    "dev": "concurrently -k -n web,api -c blue,green \"pnpm dev:web\" \"pnpm dev:backend\"",
    "dev:web": "next dev --hostname 127.0.0.1 --port 5100",
    "dev:backend": "pnpm --dir backend dev",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "concurrently -k -n web,api -c blue,green \"pnpm start:web\" \"pnpm start:backend\"",
    "start:web": "next start --port 4000",
    "start:backend": "pnpm --dir backend start",
    "ts-check": "tsc -p tsconfig.json",
    "lint:build": "eslint . --quiet",
    "migrate:database": "node scripts/migration/postgres-transfer.mjs",
    "migrate:database:verify": "node scripts/migration/verify-postgres.mjs",
    "migrate:storage": "node scripts/migration/storage-transfer.mjs",
    "migrate:storage:references": "node scripts/migration/rewrite-storage-references.mjs",
    "local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-env/manage.ps1 setup",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-env/manage.ps1 start",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-env/manage.ps1 stop",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-env/manage.ps1 status",
    "validate": "concurrently -n types,lint -c cyan,yellow \"pnpm ts-check\" \"pnpm lint:build\""
  },
