SOURCE_DATABASE_URL=
SOURCE_PG_SSL_MODE=require
SOURCE_PG_SSL_REJECT_UNAUTHORIZED=false

TARGET_DATABASE_URL=postgresql://pi_cube:change_this_database_password@localhost:5432/pi_cube
TARGET_PG_SSL_MODE=disable

SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=
SOURCE_S3_BUCKET=
SOURCE_S3_REGION=us-east-1
SOURCE_S3_ENDPOINT=
SOURCE_S3_FORCE_PATH_STYLE=false
SOURCE_S3_PREFIX=

TARGET_S3_ACCESS_KEY_ID=pi_cube_admin
