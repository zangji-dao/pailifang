# 复制为 .env.local，并仅在本地或部署平台填写真实值
NODE_ENV=development
APP_URL=http://localhost:5000
BACKEND_URL=http://localhost:4001
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# 可选：仅供本机开发的一键管理员登录，生产环境始终禁用
LOCAL_ADMIN_ONE_CLICK_ENABLED=false
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
PUBLIC_REGISTRATION_ENABLED=false

# PostgreSQL（推荐使用 DATABASE_URL）
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/pi_cube
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change_me
PG_DATABASE=pi_cube
PG_SSL_MODE=disable
PG_SSL_REJECT_UNAUTHORIZED=true

# S3 兼容对象存储
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-beijing
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# OpenAI-compatible AI 服务
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# 可选：历史检索脚本使用的 HTTP 搜索网关
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_API_METHOD=POST
SEARCH_API_KEY_HEADER=Authorization
SEARCH_API_KEY_PREFIX="Bearer "

# 支付宝开放平台配置
ALIPAY_ENVIRONMENT=production
ALIPAY_APPID=your_appid_here
ALIPAY_PRIVATE_KEY=your_private_key_here
ALIPAY_PUBLIC_KEY=alipay_public_key_here
ALIPAY_SANDBOX_APPID=your_sandbox_appid_here
ALIPAY_SANDBOX_PRIVATE_KEY=your_sandbox_private_key_here
ALIPAY_SANDBOX_PUBLIC_KEY=your_sandbox_alipay_public_key_here

# 支付宝授权回调地址
# 开发环境：使用内网穿透地址
# 生产环境：https://pi.chemicaloop.com/api/alipay/callback
ALIPAY_REDIRECT_URI=https://pi.chemicaloop.com/api/alipay/callback

# 萤石云
YSWITH_APP_KEY=
YSWITH_APP_SECRET=

# OnlyOffice
ONLYOFFICE_URL=
NEXT_PUBLIC_ONLYOFFICE_URL=
ONLYOFFICE_JWT_ENABLED=false
ONLYOFFICE_JWT_SECRET=

# 高风险数据库迁移 API 默认关闭
ALLOW_DATABASE_MIGRATION_API=false
